{
  "name": "xghost",
  "version": "1.0.0",
  "description": "Ultra-stealth, anti-AI open-source interview copilot for macOS & Windows",
  "author": "xGhost Contributors",
  "license": "MIT",
  "homepage": "https://xghost.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xalid-Go/xGhost.git"
  },
  "bugs": {
    "url": "https://github.com/Xalid-Go/xGhost/issues"
  },
  "keywords": [
    "interview",
    "interview-preparation",
    "copilot",
    "stealth",
    "hud",
    "anti-ai",
    "macos",
    "electron",
    "gemini",
    "groq",
    "leetcode",
    "system-design"
  ],
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "start": "npm run build && electron .",
    "pack:mac": "npm run build && electron-builder --mac --arm64",
    "pack:mac-dir": "npm run build && electron-builder --mac --arm64 --dir",
    "pack:win": "npm run build && electron-builder --win --x64",
    "pack:all": "npm run build && electron-builder -mw"
  },
  "build": {
    "appId": "tech.ghostgpt.xghost",
    "productName": "xGhost Copilot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vercel": "^65.0.0",
    "vite": "^6.1.0"
  }
}
